---
import CTAButton from './CTAButton.astro';

interface Props {
  label?: string;
  href?: string;
  class?: string;
}

const { label = 'Request an initial appointment', href = '/book', class: classProp = '' } = Astro.props;
---
<CTAButton href={href} variant="primary" class={classProp}>{label}</CTAButton>
