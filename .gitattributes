# Normalise line endings.
#
# Without this, editing on Windows rewrites files as CRLF while the repo stores
# LF, so `git status` reports the whole tree as modified with an equal number of
# insertions and deletions and no actual content change.
#
# `text=auto` lets git detect text files and store them as LF in the repository;
# `eol=lf` checks them out as LF too, so the working tree and the index agree.

* text=auto eol=lf

# Explicitly binary — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
