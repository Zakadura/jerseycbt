---
interface Props { url: string; variant?: 'button' | 'link'; class?: string; }
const { url, variant = 'button', class: classProp = '' } = Astro.props;
const buttonCls = 'inline-block px-6 py-3 font-sans text-sm tracking-trust uppercase border bg-warm-black text-cream border-warm-black hover:bg-body-text';
const linkCls = 'inline-block font-sans text-sm underline underline-offset-4 text-warm-black hover:text-body-text';
---
<span data-booking-popup>
  <a href={url} data-calendly-popup class={`${variant === 'link' ? linkCls : buttonCls} ${classProp}`}><slot /></a>
  <span class="booking-status" role="status" lang="en"></span>
  <span data-booking-fallback class="booking-status" lang="en" hidden>
    <a href={url} target="_blank" rel="noopener" class="underline">Open booking directly</a> or <a href="mailto:hello@jerseycbt.com" class="underline">email me</a>.
  </span>
</span>
<script>
  import { loadCalendly } from '../lib/calendly';
  document.querySelectorAll<HTMLElement>('[data-booking-popup]').forEach(host => {
    const link = host.querySelector<HTMLAnchorElement>('[data-calendly-popup]')!;
    const status = host.querySelector<HTMLElement>('[role="status"]')!;
    const fallback = host.querySelector<HTMLElement>('[data-booking-fallback]')!;
    let pending = false;
    link.addEventListener('click', async event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (pending) return;
      pending = true;
      link.setAttribute('aria-busy', 'true');
      status.textContent = 'Opening booking…';
      try {
        const api = await loadCalendly();
        api.initPopupWidget({ url: link.href });
        status.textContent = '';
        fallback.hidden = true;
      } catch {
        status.textContent = 'Booking could not open here. Please use a link below or try again.';
        fallback.hidden = false;
      } finally { pending = false; link.removeAttribute('aria-busy'); }
    });
  });
</script>
