---
import InitialAppointmentCTA from './InitialAppointmentCTA.astro';
import ConsultationCTA from './ConsultationCTA.astro';

interface Props {
  primaryLabel?: string;
  secondaryPrefix?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  primaryLabel = 'Request an initial appointment',
  secondaryPrefix = 'Not sure yet?',
  secondaryLabel = 'Book a free 15-min screening call first →',
  class: classProp = '',
} = Astro.props;
---
<div class={classProp}>
  <InitialAppointmentCTA label={primaryLabel} />
  <p class="mt-3 text-sm text-subtle-text">
    {secondaryPrefix} <ConsultationCTA variant="link" label={secondaryLabel} />
  </p>
</div>
