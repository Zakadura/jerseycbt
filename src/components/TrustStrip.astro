---
const logos = [
  { src: '/images/babcp.svg', alt: 'BABCP Accredited #101239' },
  { src: '/images/acat.svg', alt: 'ACAT Accredited' },
  { src: '/images/acat-practitioner-2026.webp', alt: 'ACAT Accredited CAT Practitioner 2026' },
  { src: '/images/psa-accredited-register.webp', alt: 'Professional Standards Authority — Accredited Register' },
];
const text = [
  '21+ years in practice',
  'NHS + private background',
];
---
<section class="bg-muted-cream border-y border-cream">
  <div class="max-w-5xl mx-auto px-6 py-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
    {logos.map((l) => (
      <img src={l.src} alt={l.alt} class="h-10 w-auto" loading="lazy" decoding="async" />
    ))}
    {text.map((t) => (
      <span class="text-xs tracking-trust uppercase text-subtle-text">{t}</span>
    ))}
  </div>
</section>
