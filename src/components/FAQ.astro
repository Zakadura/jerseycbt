---
interface Props { items: Array<{ q: string; a: string }>; }
const { items } = Astro.props;
---
<dl class="my-10 space-y-6">
  {items.map((item) => (
    <div>
      <dt class="font-serif text-xl">{item.q}</dt>
      <dd class="mt-2 text-body-text leading-relaxed">{item.a}</dd>
    </div>
  ))}
</dl>
