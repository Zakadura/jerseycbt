---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from './BookingCTA.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import StickyBookButton from './StickyBookButton.astro';
import { buildArticleJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  date: Date;
  hero?: ImageMetadata;
  /** Overrides the <title> tag when the full title would run long. */
  seoTitle?: string;
}
const { title, description, date, hero, seoTitle } = Astro.props;

const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
const articleLd = buildArticleJsonLd({
  title,
  description,
  date,
  url: articleUrl,
  image: hero?.src,
});
---
<BaseLayout
  title={seoTitle ?? `${title} — jerseycbt`}
  description={description}
  ogImage={hero?.src}
  jsonLd={[articleLd]}>
  <Nav />
  <article class="max-w-2xl mx-auto px-6 py-12">
    <header class="mb-10">
      <p class="text-xs tracking-trust uppercase text-subtle-text mb-3">
        {date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
      </p>
      <h1 class="font-serif text-4xl md:text-5xl leading-tight">{title}</h1>
    </header>
    <div class="prose prose-lg prose-stone max-w-none">
      <slot />
    </div>
    <div class="mt-16 border-t border-muted-cream pt-10">
      <BookingCTA />
    </div>
  </article>
  <Footer />
  <StickyBookButton />
</BaseLayout>
