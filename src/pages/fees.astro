---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PriceTable from '../components/PriceTable.astro';
import InsuranceLogos from '../components/InsuranceLogos.astro';
import BookingCTA from '../components/BookingCTA.astro';
import SessionCTA from '../components/SessionCTA.astro';
import StickyBookButton from '../components/StickyBookButton.astro';
import { buildOfferJsonLd } from '../lib/jsonld';

const feesUrl = new URL(Astro.url.pathname, Astro.site).toString();
const serviceLd = buildOfferJsonLd(feesUrl);
---
<BaseLayout
  title="Therapy Costs in Jersey — £100 per Session | Fees"
  description="Private therapy fees in Jersey — £100 per 50-minute session, free 15-min consultation. CBT and CAT. AXA, Aviva, Vitality, Aetna."
  jsonLd={[serviceLd]}>
  <Nav />
  <main id="main-content" tabindex="-1" class="max-w-2xl mx-auto px-6 py-16">
    <h1 class="font-serif text-4xl md:text-5xl text-warm-black">Fees</h1>
    <p class="mt-4 text-subtle-text">
      Sessions are £100 for 50 minutes — the same whether we meet in Saint Helier or online. One clear rate: no packages, no tiers. The free 15-minute call beforehand is a fit conversation, not a session — a chance to say what you're bringing and hear how I'd work with it, with no obligation to book.
    </p>

    <PriceTable />

    <section class="mt-12 content-prose">
      <h2>Using insurance</h2>
      <p>
        If you're claiming through private health insurance, check your policy for cover and any pre-authorisation you'll need before we start — and I'll provide invoices for your claim. Accepted insurers are below.
      </p>
    </section>

    <InsuranceLogos />

    <div class="mt-12 flex flex-col sm:flex-row gap-6">
      <BookingCTA />
      <SessionCTA />
    </div>
  </main>
  <Footer />
  <StickyBookButton />
</BaseLayout>
