---
import CalendlyPopupButton from './CalendlyPopupButton.astro';
interface Props { url: string; eventType?: 'consultation' | 'session'; height?: number; }
const { url, height = 700 } = Astro.props;
---
<section data-booking-inline data-url={url} class="booking-inline" aria-label="Screening-call booking" lang="en">
  <p class="text-sm mb-4">You can also <a href={url} target="_blank" rel="noopener" class="underline">open booking directly</a> or <a href="mailto:hello@jerseycbt.com" class="underline">email me</a>.</p>
  <p class="text-sm mb-4"><CalendlyPopupButton url={url} variant="link">Open booking in a window</CalendlyPopupButton></p>
  <p role="status" class="booking-status"></p>
  <div data-booking-host class="booking-host bg-muted-cream" style={`height:${height}px`} hidden></div>
  <button type="button" data-booking-retry class="booking-retry" hidden>Try loading booking again</button>
  <noscript><p>Use the booking or email link above to book a screening call.</p></noscript>
</section>
<script>
  import { loadCalendly } from '../lib/calendly';
  import { observeAndLoad } from '../lib/lazyEmbed';
  document.querySelectorAll<HTMLElement>('[data-booking-inline]').forEach(section => {
    const host = section.querySelector<HTMLElement>('[data-booking-host]')!;
    const status = section.querySelector<HTMLElement>(':scope > [role="status"]')!;
    const retry = section.querySelector<HTMLButtonElement>('[data-booking-retry]')!;
    let pending = false;
    let ready = false;
    const load = async () => {
      if (pending || ready) return;
      pending = true;
      status.textContent = 'Loading booking…';
      retry.hidden = true;
      host.hidden = false;
      try {
        const api = await loadCalendly();
        host.replaceChildren();
        api.initInlineWidget({ url: section.dataset.url!, parentElement: host });
        ready = true;
        status.textContent = '';
      } catch {
        status.textContent = 'Booking could not load here. Use the booking or email link above, or try again.';
        host.hidden = true;
        retry.hidden = false;
      } finally { pending = false; }
    };
    retry.addEventListener('click', load);
    observeAndLoad(section, load);
  });
</script>
